#!/bin/sh
# Runs after packages are installed (mkosi calls this). NOT inside the
# image: / here is the build host (or mkosi's sandbox of it) and the image's
# root is $BUILDROOT, so every image path below is prefixed with it. That,
# not any persistence quirk, is why the useradd/chmod attempts described
# below never touched the image.
# Wires up the FerrousNAS service and first-boot configuration.
set -eu

echo "==> Configuring FerrousNAS appliance"

# The `ferrous` service account is declared in
# mkosi.extra/usr/lib/sysusers.d/ferrous-nas.conf, not created here with
# useradd. Two failed builds established that useradd genuinely reports
# success (exit 0) but its write to /etc/passwd does not persist inside
# whatever sandbox mkosi wraps this script's execution in ("sandbox command
# omitted, rerun with --debug" in the build log) — the account was verified
# MISSING immediately afterward, in the same script. sysusers.d sidesteps
# that entirely: systemd-sysusers processes it against the real rootfs at
# first boot (systemd-sysusers.service, part of sysinit.target — guaranteed
# to run before ferrous-nasd.service, which is in multi-user.target), no
# build-time script sandbox involved at all.
#
# Likewise, /var/lib/ferrous-nas's ownership isn't set up here either —
# ferrous-nasd.service already declares StateDirectory=ferrous-nas, so
# systemd creates and chowns it correctly before every service start.

# mkosi.extra/ already placed the daemon binary and web assets on the rootfs
# at their final paths before this script runs — nothing left to do for
# either here. Two things were tried and removed:
#
# `chmod 755 /usr/local/bin/ferrous-nasd` failed with "No such file or
# directory" even though the file demonstrably exists in mkosi.extra/ on the
# host with mode 755 already (from `install -Dm755` when it was staged).
#
# `install -d /usr/local/share/ferrous-nas/web` failed outright with "Read-
# only file system" — which resolves the mystery above too: this script's
# sandbox ("sandbox command omitted, rerun with --debug" in the build log)
# mounts /usr read-only, so it can neither write there nor reliably see
# writes/content that landed there via a different mechanism (extra-trees,
# in this case) moments earlier in the same build. Both lines were always
# redundant anyway — the binary's mode and the web directory's existence are
# already correct from how mkosi.extra/ was staged — so the fix is simply to
# stop touching /usr from postinst at all, rather than work around a
# deliberately read-only mount.

# Wire up the managed Samba fragment sharemgr::linux writes to at runtime
# (FERROUS_SHARES=linux) so shares work without a manual smb.conf edit.
# Idempotent: safe to re-run this script. Unrelated to the /usr sandbox
# issues above (this touches /etc, and it's a genuinely different failure):
# live build showed /etc/samba/smb.conf doesn't exist at all at this point.
# Confirmed against Debian's own package file lists — samba-common ships
# only a *template* at /usr/share/samba/smb.conf; the live /etc/samba/smb.conf
# is normally generated by an interactive debconf prompt (workgroup name,
# etc.) that a non-interactive image build like this one never runs. So:
# copy the template into place first if nothing's there yet, matching what
# that debconf step would otherwise have done, then add our include line.
smb=$BUILDROOT/etc/samba/smb.conf
if [ ! -f "$smb" ] && [ -f "$BUILDROOT/usr/share/samba/smb.conf" ]; then
    cp "$BUILDROOT/usr/share/samba/smb.conf" "$smb"
fi
if [ -f "$smb" ] && ! grep -q ferrousnas-shares.conf "$smb"; then
    sed -i '/^\[global\]/a\   include = /etc/samba/ferrousnas-shares.conf' "$smb"
fi

# Enabling ferrous-nasd.service is *not* done here via `systemctl enable`:
# that unit is staged via mkosi.extra/ (same category as the binary above),
# so it's at the same risk of not being visible to this script. Instead, the
# enablement symlink systemctl enable would have created is staged directly:
# mkosi.extra/etc/systemd/system/multi-user.target.wants/ferrous-nasd.service
# -> ../ferrous-nasd.service, matching its [Install] WantedBy=multi-user.target.
#
# smbd/nmbd/nfs-server/docker were already enabled by their own packages'
# maintainer scripts during normal package installation (visible in the
# build log — the same phase, again, that isn't affected) — nothing to do
# for them here.

# Optional console/SSH login account, requested at build time:
#     sudo mkosi --environment=FERROUS_ADMIN_USER=<name> \
#                --environment=FERROUS_ADMIN_PASSWORD=<password> -f build
# Only a hash is stored in the image; ferrous-console-user.service creates
# the account (in the sudo group) on first boot. Without these the image has
# no login account at all, which is the default.
if [ -n "${FERROUS_ADMIN_USER:-}" ] && [ -n "${FERROUS_ADMIN_PASSWORD:-}" ]; then
    install -d -m 700 "$BUILDROOT/etc/ferrous-nas"
    umask 077
    printf '%s:%s\n' "$FERROUS_ADMIN_USER" \
        "$(printf '%s' "$FERROUS_ADMIN_PASSWORD" | openssl passwd -6 -stdin)" \
        > "$BUILDROOT/etc/ferrous-nas/console-user"
    echo "==> Login account '$FERROUS_ADMIN_USER' will be created on first boot"
fi

echo "==> Done. Boot the image and browse to https://<ip>:4200 (self-signed cert)"
