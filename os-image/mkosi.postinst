#!/bin/sh
# Runs inside the image after packages are installed (mkosi calls this).
# Wires up the FerrousNAS service and first-boot configuration.
set -eu

echo "==> Configuring FerrousNAS appliance"

# The `ferrous` service account is declared in
# mkosi.extra/usr/lib/sysusers.d/ferrous-nas.conf, not created here with
# useradd. Two failed builds established that useradd genuinely reports
# success (exit 0) but its write to /etc/passwd does not persist inside
# whatever sandbox mkosi wraps this script's execution in ("sandbox command
# omitted, rerun with --debug" in the build log) — the account was verified
# MISSING immediately afterward, in the same script. sysusers.d sidesteps
# that entirely: systemd-sysusers processes it against the real rootfs at
# first boot (systemd-sysusers.service, part of sysinit.target — guaranteed
# to run before ferrous-nasd.service, which is in multi-user.target), no
# build-time script sandbox involved at all.
#
# Likewise, /var/lib/ferrous-nas's ownership isn't set up here either —
# ferrous-nasd.service already declares StateDirectory=ferrous-nas, so
# systemd creates and chowns it correctly before every service start.

# mkosi.extra/ already placed the daemon binary and web assets on the rootfs
# at their final paths before this script runs — just make sure the binary
# is executable.
chmod 755 /usr/local/bin/ferrous-nasd
install -d /usr/local/share/ferrous-nas/web

# Wire up the managed Samba fragment sharemgr::linux writes to at runtime
# (FERROUS_SHARES=linux) so shares work without a manual smb.conf edit.
# Idempotent: safe to re-run this script.
if ! grep -q ferrousnas-shares.conf /etc/samba/smb.conf 2>/dev/null; then
    sed -i '/^\[global\]/a\   include = /etc/samba/ferrousnas-shares.conf' /etc/samba/smb.conf
fi

# systemd: start the daemon on boot.
systemctl enable ferrous-nasd.service

# Enable the underlying NAS services a non-mock build would drive.
systemctl enable smbd nmbd nfs-server docker ssh || true

echo "==> Done. Boot the image and browse to https://<ip>:4200 (self-signed cert)"
