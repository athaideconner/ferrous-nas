#!/bin/sh
# Runs inside the image after packages are installed (mkosi calls this).
# Wires up the FerrousNAS service and first-boot configuration.
set -eu

echo "==> Configuring FerrousNAS appliance"

# The `ferrous` service account is declared in
# mkosi.extra/usr/lib/sysusers.d/ferrous-nas.conf, not created here with
# useradd. Two failed builds established that useradd genuinely reports
# success (exit 0) but its write to /etc/passwd does not persist inside
# whatever sandbox mkosi wraps this script's execution in ("sandbox command
# omitted, rerun with --debug" in the build log) — the account was verified
# MISSING immediately afterward, in the same script. sysusers.d sidesteps
# that entirely: systemd-sysusers processes it against the real rootfs at
# first boot (systemd-sysusers.service, part of sysinit.target — guaranteed
# to run before ferrous-nasd.service, which is in multi-user.target), no
# build-time script sandbox involved at all.
#
# Likewise, /var/lib/ferrous-nas's ownership isn't set up here either —
# ferrous-nasd.service already declares StateDirectory=ferrous-nas, so
# systemd creates and chowns it correctly before every service start.

# mkosi.extra/ already placed the daemon binary and web assets on the rootfs
# at their final paths before this script runs. Not re-chmod'ing the binary
# here on purpose: `chmod 755 /usr/local/bin/ferrous-nasd` failed with "No
# such file or directory" even though the file demonstrably exists in
# mkosi.extra/ on the host with mode 755 already (from `install -Dm755` when
# it was staged) — the same class of postinst-sandbox visibility mismatch as
# the useradd issue above, this time for a path under /usr rather than /etc.
# The chmod was always redundant anyway (the staged file's mode is already
# correct), so the fix is the same as before: stop touching it here rather
# than chase why the sandbox can't see it. `install -d` below is left in
# place since, unlike chmod, it can't fail on an already-existing directory
# either way.
install -d /usr/local/share/ferrous-nas/web

# Wire up the managed Samba fragment sharemgr::linux writes to at runtime
# (FERROUS_SHARES=linux) so shares work without a manual smb.conf edit.
# Idempotent: safe to re-run this script. Unlike the two issues above, this
# touches a file the samba *package* installed during normal package
# installation, not something from mkosi.extra/ or created within this
# script — the same phase that successfully created system users like
# `statd` earlier in the same build — so it isn't expected to hit the same
# visibility problem. If it turns out to, that would mean the issue is
# broader than extra-trees/postinst-created-accounts specifically.
if ! grep -q ferrousnas-shares.conf /etc/samba/smb.conf 2>/dev/null; then
    sed -i '/^\[global\]/a\   include = /etc/samba/ferrousnas-shares.conf' /etc/samba/smb.conf
fi

# Enabling ferrous-nasd.service is *not* done here via `systemctl enable`:
# that unit is staged via mkosi.extra/ (same category as the binary above),
# so it's at the same risk of not being visible to this script. Instead, the
# enablement symlink systemctl enable would have created is staged directly:
# mkosi.extra/etc/systemd/system/multi-user.target.wants/ferrous-nasd.service
# -> ../ferrous-nasd.service, matching its [Install] WantedBy=multi-user.target.
#
# smbd/nmbd/nfs-server/docker were already enabled by their own packages'
# maintainer scripts during normal package installation (visible in the
# build log — the same phase, again, that isn't affected) — nothing to do
# for them here.

echo "==> Done. Boot the image and browse to https://<ip>:4200 (self-signed cert)"
