# ferrous-kiosk.service: the dashboard on this machine's screen. Nothing
# asks for a password (the dashboard has its own sign-in); pam_systemd
# registers a logind session on tty1, which grants the display and input
# devices to the kiosk's account.
auth     required  pam_unix.so
account  required  pam_unix.so
session  required  pam_unix.so
session  required  pam_systemd.so
