[Unit]
Description=FerrousNAS control-plane daemon
Documentation=https://github.com/athaideconner/ferrous-nas
# Pools mounted, and the services it configures up, before it starts.
After=network-online.target docker.service zfs-mount.service smbd.service nfs-server.service
Wants=network-online.target docker.service

[Service]
Type=exec
# Root, because every real backend enabled below needs it: zpool/zfs,
# Samba/NFS config under /etc and reloading those services, useradd and
# smbpasswd, smartctl, power actions, and the Docker socket (which is
# root-equivalent anyway). The dashboard's own login and admin checks are
# what stands between the network and these.
Environment=FERROUS_ADDR=0.0.0.0:4200
Environment=FERROUS_WEB_DIR=/usr/local/share/ferrous-nas/web
Environment=RUST_LOG=info
# Everything real (see the README's env var table):
#   telemetry — this machine's own stats, disks and network
#   apps      — store apps run as Docker containers
#   pools     — ZFS pools and datasets; destructive operations (creating or
#               destroying a pool, destroying a dataset) are enabled, and
#               only ever touch blank disks — never the system disk
#   shares    — SMB/NFS shares of those datasets
#   users     — dashboard users get matching OS and Samba accounts
#   power     — reboot / shut down really happen
Environment=FERROUS_TELEMETRY=linux
Environment=FERROUS_APPS=docker
Environment=FERROUS_POOLS=zfs
Environment=FERROUS_POOLS_DESTRUCTIVE=i-understand
Environment=FERROUS_SHARES=linux
Environment=FERROUS_USERS=linux
Environment=FERROUS_POWER=systemd
ExecStart=/usr/local/bin/ferrous-nasd
Restart=on-failure
RestartSec=2

# No ProtectSystem=/ProtectHome=/PrivateTmp=: each gives the service its own
# mount namespace, and a ZFS pool or dataset created in there would be
# mounted only inside it — Samba and NFS, outside, would serve the empty
# folder underneath.
NoNewPrivileges=yes
StateDirectory=ferrous-nas

[Install]
WantedBy=multi-user.target
