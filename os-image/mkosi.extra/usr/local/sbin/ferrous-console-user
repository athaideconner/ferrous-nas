#!/bin/sh
# First boot: create the Linux login account requested at build time
# (/etc/ferrous-nas/console-user holds "name:password-hash"), in the sudo
# group, then delete the request. Done here, by the running system, so the
# account is made exactly as useradd on the real install would make it.
set -eu
req=/etc/ferrous-nas/console-user
IFS= read -r line < "$req"
user=${line%%:*}
id "$user" >/dev/null 2>&1 || useradd -m -s /bin/bash -G sudo "$user"
printf '%s\n' "$line" | chpasswd -e
rm -f "$req"
